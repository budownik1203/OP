; Ostatni Pluton - konfiguracja projektu Godot 4.7
config_version=5

[application]

config/name="Ostatni Pluton"
config/version="0.0.1"
run/main_scene="res://sceny/gra.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

Jezyk="*res://skrypty/auto/jezyk.gd"
Wejscie="*res://skrypty/auto/wejscie.gd"
Strojenie="*res://skrypty/auto/strojenie.gd"
Amunicja="*res://skrypty/auto/amunicja.gd"
Dzwiek="*res://skrypty/auto/dzwiek.gd"
Ekwipunek="*res://skrypty/auto/ekwipunek.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[physics]

common/physics_ticks_per_second=120
3d/physics_engine="Jolt Physics"

[rendering]

textures/canvas_textures/default_texture_filter=0
anti_aliasing/quality/msaa_3d=0
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/positional_shadow/atlas_size=2048
environment/defaults/default_clear_color=Color(0.02, 0.02, 0.025, 1)
